# Proxy configuration (only the proxy needs configuration; the SPA is environment-agnostic).
HARNESS_URL=http://localhost:8086
PORT=3000
MCP_TRANSPORT=sse

# Origins the X-Harness-Url header may target, beyond loopback and the HARNESS_URL
# origin. Comma-separated; an origin is scheme + host + port. Required to point the
# masthead URL field at a remote harness — see README "Retargeting the harness".
# HARNESS_URL_ALLOWLIST=https://harness.staging.example:8443

# Proxy rate limit. Defaults to 600 requests per 60s.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=600
