# Required: LLM provider API key
# Must match the value of api_key_env in config/harness.yaml
# Example: if harness.yaml has  api_key_env: OPENAI_API_KEY
OPENAI_API_KEY=your-openai-api-key-here

# Optional: custom API base URL (e.g. for Azure OpenAI or a local proxy)
# Set this to match api_base_env in harness.yaml if configured
# OPENAI_API_BASE=https://your-resource.openai.azure.com/

# Optional: path to the harness config YAML (default: config/harness.yaml)
# HARNESS_CONFIG_PATH=config/harness.yaml
