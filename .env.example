# Required: LLM provider API key
# In Kubernetes, this is delivered via valueFrom.secretKeyRef.
# In local dev, set it here.
LLM_API_KEY=your-api-key-here

# Optional: custom API base URL for an OpenAI-compatible endpoint
# (Azure OpenAI, a LiteLLM proxy, vLLM, Ollama, ...). Leave unset for api.openai.com.
# LLM_API_BASE=https://your-proxy.example.com/v1

# Optional: path to the harness config YAML (default: config/harness.yaml)
# HARNESS_CONFIG_PATH=config/harness.yaml

# Optional: override the models from config/harness.yaml without editing it.
# Useful when the harness runs from an image whose harness.yaml you can't edit,
# or when LLM_API_BASE points at a gateway that namespaces models differently.
# The id is sent verbatim as the `model` field, so use whatever name that
# endpoint expects (bare `gpt-4.1` for api.openai.com).
# HARNESS_LLM_PROVIDER=openai
# HARNESS_LLM_SKILL_GENERATION_MODEL=gpt-4.1
# HARNESS_LLM_SIMULATION_MODEL=gpt-4.1
